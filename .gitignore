# ── תוצרי הבנייה ─────────────────────────────────────────────────────────────
# `native/build/` מחזיק את הכול: ה-exe, ה-obj, חבילת הממשק הדחוסה,
# ומשאב הגרסה המיוצר.
native/build/

# ה-SDK של WebView2 מובא ע"י `native/tools/fetch_webview2.ps1` מ-nuget לפי
# גרסה נעוצה, ולכן אינו נשמר בגיט — 87 קבצים שאינם שלנו.
native/third_party/

# תיקיית הנתונים שהתוכנה יוצרת לצד קובץ ההרצה בהרצה מקומית.
Data/

# ── כללי ─────────────────────────────────────────────────────────────────────
*.log
*.swp
.DS_Store
Thumbs.db

# ── עורכים ───────────────────────────────────────────────────────────────────
.idea/
*.iml
# תיקיית .vscode מכילה גם הגדרות שכן שווה לגרסא; מבוטל כברירת מחדל.
#.vscode/

# ⚠️ `native/test/fixtures/sample.otzplugin` **כן** מגורסא (357 בתים).
# הוא נוצר ע"י כותב ZIP **חיצוני** (`System.IO.Compression` של .NET),
# וזו כל התועלת שבו: קורא ה-ZIP שלנו נבדק מול קובץ שלא אנחנו כתבנו.
# ייצור שלו בזמן הבדיקה היה הופך את הבדיקה למעגלית.
