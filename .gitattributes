* text=auto

# ⚠️ CRLF שובר את השניים האלה ב-Linux: shebang עם \r אינו נמצא, ושורות
# עם \r בתוך בלוק `run:` נכנסות לסקריפט שהראנר מייצר. הג'ובים של ubuntu
# ב-CI מריצים את שניהם.
*.sh text eol=lf
*.yml text eol=lf

# סקריפטי האריזה נשמרים UTF-8 **עם BOM** כדי ש-PowerShell 5.1 תקרא את
# העברית שבהם נכון. BOM אינו נפגע מנרמול שורות, אבל הסימון כאן מונע כל
# טיפול אחר.
*.ps1 text eol=crlf

# בינאריים.
*.ico binary
*.png binary
